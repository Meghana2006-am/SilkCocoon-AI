# SilkCocoonAI Environment Configuration
# Copy this file to .env and insert your real credentials.
# NEVER commit your real .env file with secrets to Git or GitHub.

# Primary Multimodal Vision AI: Google Gemini API Key
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Selected Multimodal Model (Default: gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# Maximum Upload File Size Limit in Megabytes (Default: 10)
MAX_UPLOAD_SIZE_MB=10

# Optional Alternative: Hugging Face Token (if using open-source vision-language model)
# HUGGINGFACE_API_KEY=your_hf_token_here
